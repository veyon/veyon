      </item>
      <item row="3" column="1">
       <widget class="QLineEdit" name="logonSwitchUserKeySequence">
        <property name="toolTip">
         <string>Keys sent on the sign-in screen to switch from the tile of the last signed-in user to "Other user" before entering the credentials. Not sent when logging on the last signed-in user again or when the sign-in screen already asks for a user name. Leave empty to disable. Separate keys with spaces. Supported: Tab, Return, Escape, Space, Backspace, Delete, Up, Down, Left, Right, Home, End, PageUp, PageDown, F1-F12, letters and digits, modifiers Shift+, Ctrl+, Alt+, Win+ and pauses such as Wait:500 (milliseconds).</string>
        </property>
        <property name="placeholderText">
         <string notr="true">Tab Tab Return Wait:1000</string>
        </property>
