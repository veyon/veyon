[Unit]
Description=Veyon Service
After=dbus.service systemd-logind.service veyon-login-helper.service
Before=display-manager.service
Wants=veyon-login-helper.service
Requires=dbus.service systemd-logind.service
Documentation=man:veyon-service(1)
StartLimitIntervalSec=0

[Service]
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/veyon-service
Type=simple
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

