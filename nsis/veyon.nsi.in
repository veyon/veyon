######################################################################

Section "Veyon Service" SEC_SERVICE
SectionIn RO
${INSTALL_TYPE}
ClearErrors
ExecWait '"$INSTDIR\veyon-wcli.exe" service unregister'
${If} $0 != 0
  ExecWait '"$INSTDIR\veyon-ctl.exe" service unregister'
${EndIf}
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\plugins\*.dll"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\translations"
SetOverwrite on
SetOutPath "$INSTDIR"
# core components
File "veyon-server.exe"
File "veyon-service.exe"
File "veyon-configurator.exe"
File "veyon-cli.exe"
File "veyon-wcli.exe"
File "veyon-worker.exe"
File "*.dll"
File "LICENSE.TXT"
File "README.TXT"
# plugins
SetOutPath "$INSTDIR\plugins"
File "plugins/*.dll"
# translations
SetOutPath "$INSTDIR\translations"
File "translations/*.qm"
# QCA plugins
SetOutPath "$INSTDIR\crypto"
File "crypto/*.dll"
# Qt image format plugin
SetOutPath "$INSTDIR\imageformats"
File "imageformats/qjpeg.dll"
# Qt platform plugin
SetOutPath "$INSTDIR\platforms"
File "platforms/qwindows.dll"
SetOutPath "$INSTDIR\styles"
File "styles/*.dll"
# Qt TLS backend
SetOutPath "$INSTDIR\tls"
File "tls/qopensslbackend.dll"
# default authentication keys
SetOutPath "$INSTDIR\default-keys"
File "default-keys/*"
# configuration
ExecWait '"$INSTDIR\veyon-wcli.exe" service register'
ExecWait '"$INSTDIR\veyon-wcli.exe" config set Network/FirewallExceptionEnabled 1'
ExecWait '"$INSTDIR\veyon-wcli.exe" config set Windows/SoftwareSASEnabled 1'
ExecWait '"$INSTDIR\veyon-wcli.exe" config set UI/Language "id_ID"'
ExecWait '"$INSTDIR\veyon-wcli.exe" config set Authentication/Method 1'
${If} ${FileExists} "$INSTDIR\default-keys\public.key"
  ExecWait '"$INSTDIR\veyon-wcli.exe" authkeys import teacher/public "$INSTDIR\default-keys\public.key"'
${EndIf}
ExecWait '"$INSTDIR\veyon-wcli.exe" networkobjects add location "Lab Komputer SMA Muhammadiyah 1 Palembang"'
# disable forced guest logon as otherwise logon authentication fails
WriteRegDWORD ${REG_ROOT} "SYSTEM\CurrentControlSet\Control\Lsa"  "ForceGuest" "0"
${GetParameters} $R0
${GetOptions} $R0 "/ApplyConfig=" $R1
${If} $R1 != ""
  ClearErrors
  ExecWait '"$INSTDIR\veyon-wcli.exe" config import "$R1"' $0
  ${If} $0 != 0
	   MessageBox MB_OK|MB_ICONSTOP "Could not apply specified configuration file!"
  ${EndIf}
${EndIf}
ExecWait '"$INSTDIR\veyon-wcli.exe" service start'
SectionEnd

Section "Insight Teacher (Master / Guru)" SEC_MASTER
${INSTALL_TYPE}
SetOutPath "$INSTDIR"
File "veyon-master.exe"

# Pre-configured private key for Teacher Master PC
${If} ${FileExists} "$INSTDIR\default-keys\private.key"
  ExecWait '"$INSTDIR\veyon-wcli.exe" authkeys import teacher/private "$INSTDIR\default-keys\private.key"'
${EndIf}

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Insight Teacher"
CreateShortCut "$SMPROGRAMS\Insight Teacher\Insight Teacher.lnk" "$INSTDIR\${MAIN_APP_EXE}"
${EndIf}
CreateShortCut "$DESKTOP\Insight Teacher.lnk" "$INSTDIR\${MAIN_APP_EXE}"
SectionEnd

Section "Interception driver" SEC_INTERCEPTION
${INSTALL_TYPE}
SetOutPath "$INSTDIR\interception"
File "interception/*"
SectionEnd

Function RunConfigurator
	Exec '"$INSTDIR\veyon-configurator.exe"'
FunctionEnd


######################################################################

Function .onInit
${GetParameters} $R0
${GetOptions} $R0 "/NoMaster" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_MASTER}
${EndIf}
${GetOptions} $R0 "/NoInterception" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_INTERCEPTION}
${EndIf}
UserInfo::GetAccountType
pop $0
${If} $0 != "admin"
	MessageBox mb_iconstop "Silakan jalankan installer dengan hak Administrator!"
	SetErrorLevel 740 ;ERROR_ELEVATION_REQUIRED
	Quit
${EndIf}
FunctionEnd

######################################################################

Section -Icons_Reg
SetOutPath "$INSTDIR"
WriteUninstaller "$INSTDIR\uninstall.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\Insight Teacher"
CreateShortCut "$SMPROGRAMS\Insight Teacher\Insight Konfigurator.lnk" "$INSTDIR\veyon-configurator.exe"
CreateShortCut "$SMPROGRAMS\Insight Teacher\Uninstall Insight Teacher.lnk" "$INSTDIR\uninstall.exe"
WriteIniStr "$INSTDIR\Website Sekolah.url" "InternetShortcut" "URL" "${WEB_SITE}"
CreateShortCut "$SMPROGRAMS\Insight Teacher\Website Sekolah.lnk" "$INSTDIR\Website Sekolah.url"
${EndIf}

WriteRegStr ${REG_ROOT} "${REG_APP_PATH}" "" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayName" "Insight Teacher"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "UninstallString" "$INSTDIR\uninstall.exe"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayIcon" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayVersion" "${VERSION}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "Publisher" "${COMP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "URLInfoAbout" "${WEB_SITE}"
SectionEnd

######################################################################

Section Uninstall
${INSTALL_TYPE}

ExecWait '"$INSTDIR\veyon-wcli.exe" config set Service/SoftwareSASEnabled 0'
ExecWait '"$INSTDIR\veyon-wcli.exe" config set Network/FirewallExceptionEnabled 0'
ExecWait '"$INSTDIR\veyon-wcli.exe" service unregister'
ExecWait '"$INSTDIR\interception\install-interception.exe" /uninstall'
# make sure the service is stopped and all file handles are released
Sleep 2000

${GetParameters} $R0
${GetOptions} $R0 "/ClearConfig" $R1
${IfNot} ${Errors}
	ExecWait '"$INSTDIR\veyon-wcli.exe" config clear'
${EndIf}

Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.TXT"
Delete "$INSTDIR\*.url"
RmDir /r "$INSTDIR\crypto"
RmDir /r "$INSTDIR\imageformats"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\platforms"
RmDir /r "$INSTDIR\styles"
RmDir /r "$INSTDIR\tls"
RmDir /r "$INSTDIR\translations"
RmDir /r "$INSTDIR\interception"
RmDir /r "$INSTDIR\default-keys"

RmDir "$INSTDIR"

Delete "$SMPROGRAMS\Insight Teacher\Insight Teacher.lnk"
Delete "$SMPROGRAMS\Insight Teacher\Insight Konfigurator.lnk"
Delete "$SMPROGRAMS\Insight Teacher\Uninstall Insight Teacher.lnk"
Delete "$SMPROGRAMS\Insight Teacher\Website Sekolah.lnk"
RmDir "$SMPROGRAMS\Insight Teacher"

Delete "$DESKTOP\Insight Teacher.lnk"

DeleteRegKey ${REG_ROOT} "${REG_APP_PATH}"
DeleteRegKey ${REG_ROOT} "${UNINSTALL_PATH}"
SectionEnd

######################################################################

Function un.onInit
!insertmacro MUI_UNGETLANGUAGE
FunctionEnd

######################################################################

LangString DESC_SEC_SERVICE ${LANG_INDONESIAN} "Layanan latar belakang Insight Student dan file inti yang wajib ada di setiap PC laboratorium"
LangString DESC_SEC_SERVICE ${LANG_ENGLISH} "Insight Student service and common files required on all computers"
LangString DESC_SEC_MASTER ${LANG_INDONESIAN} "Aplikasi Guru untuk memantau, mendemonstrasikan layar, dan mengontrol PC siswa"
LangString DESC_SEC_MASTER ${LANG_ENGLISH} "Teacher application for monitoring and controlling client computers"
LangString DESC_SEC_INTERCEPTION ${LANG_INDONESIAN} "Driver sistem untuk mengunci shortcut keyboard saat layar siswa dikunci"
LangString DESC_SEC_INTERCEPTION ${LANG_ENGLISH} "Special input device driver required for intercepting keyboard shortcuts in screen lock mode"

